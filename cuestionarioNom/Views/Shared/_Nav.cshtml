                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                <li class="nav-item">
                    <a class="nav-link @Active(null,"Home","Index")" asp-area="" asp-controller="Home" asp-action="Index">
                        Inicio
                    </a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @(Active(null,"Surveys",null))" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Encuestas
                    </a>
                    <ul class="dropdown-menu">
                        <!-- Si ya sabes un ID de cuestionario, apunta directo -->
