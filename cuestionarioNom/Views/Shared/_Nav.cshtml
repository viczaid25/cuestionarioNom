                        </li>
                        <li>
                            <a class="dropdown-item" asp-area="Admin" asp-controller="Rules" asp-action="Index" asp-route-questionnaireId="1">
                                Reglas de calificación (ID=1)
                            </a>
                        </li>
                    </ul>
                </li>

            </ul>

